[
 {
  "do": "tool",
  "name": "open_drawing",
  "args": {
   "path": "${SCEN}/files/room.dxf"
  }
 },
 {
  "do": "type",
  "text": "@view @entity #18 @block Bolt @layer Nope @entity #9999 @drawing compare"
 },
 {
  "do": "shot",
  "file": "${OUT}/05_pills.png",
  "of": "ai"
 },
 {
  "do": "send"
 },
 {
  "do": "wait_idle",
  "timeout": 30000
 },
 {
  "do": "shot",
  "file": "${OUT}/06_sent.png",
  "of": "ai"
 },
 {
  "do": "dump",
  "file": "${OUT}/06_dump.txt",
  "in": "ai"
 },
 {
  "do": "expect",
  "in": "ai",
  "regex": "@layer Nope @entity #9999 <span",
  "label": "@entity #9999 (not in the drawing) stays plain like @layer Nope"
 },
 {
  "do": "expect",
  "in": "file:${OUT}/requests.jsonl",
  "regex": "<mention name=\\\\\"@entity #18\\\\\">",
  "label": "@entity #18 expanded"
 },
 {
  "do": "expect",
  "in": "file:${OUT}/requests.jsonl",
  "regex": "<mention name=\\\\\"@entity #9999",
  "not": true,
  "label": "@entity #9999 not expanded"
 },
 {
  "do": "quit"
 }
]