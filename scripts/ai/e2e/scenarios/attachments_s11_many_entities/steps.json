 {
  "do": "tool",
  "name": "context_menu",
  "args": {
   "x": 200,
   "y": 65,
   "item": "Ask AI about this"
  },
  "out": "${OUT}/ask131.txt"
 },
 {
  "do": "wait",
  "ms": 400
 },
 {
  "do": "expect",
  "in": "ai",
  "regex": "\\[input\\] @entity #131 \\n",
  "label": "Ask AI on #131"
 },
 {
  "do": "tool",
  "name": "context_menu",
  "args": {
   "x": 40,
   "y": 5,
   "item": "Ask AI about this"
  },
  "out": "${OUT}/ask13.txt"
 },
 {
  "do": "wait",
  "ms": 400
 },
 {
  "do": "tool",
  "name": "get_drawing_info",
  "args": {},
  "out": "${OUT}/info.txt"
 },
 {
  "do": "tool",
  "name": "list_entities",
  "args": {
   "selected_only": true
  },
  "out": "${OUT}/selected.txt"
 },
 {
  "do": "shot",
  "file": "${OUT}/01_after_ask13.png",
  "of": "main"
 },
 {
  "do": "dump",
  "file": "${OUT}/01_dump.txt",
  "in": "ai"
 },
 {
  "do": "expect",
  "in": "ai",
  "regex": "\\[input\\] @entity #131 @entity #13 ",
  "label": "Ask AI on #13 adds @entity #13 after @entity #131"
 },
 {
  "do": "type",
  "text": ""
 },
 {
  "do": "keys",
  "text": "@131"
 },
 {
  "do": "dump",
  "file": "${OUT}/02_popup.txt",
  "in": "ai"
 },
 {
  "do": "expect",
  "in": "ai",
  "regex": "\\[row\\] @entity #131",
  "label": "popup finds entity by id"
 },
 {
  "do": "keys",
  "keys": "Escape"
 },
 {
  "do": "type",
  "text": ""
 },
 {
  "do": "keys",
  "text": "@13"
 },
 {
  "do": "dump",
  "file": "${OUT}/02b_popup.txt",
  "in": "ai"
 },
 {
  "do": "expect",
  "in": "ai",
  "regex": "\\[row\\] Entities\\n\\[row\\] @entity #13\\n",
  "label": "@13: the exact id before #130.."
 },
 {
  "do": "keys",
  "keys": "Escape"
 },
 {
  "do": "tool",
  "name": "select_entities",
  "args": {
   "all": true
  }
 },
 {
  "do": "type",
  "text": "@selection how many circles?"
 },
 {
  "do": "send"
 },
 {
  "do": "wait_idle",
  "timeout": 30000
 },
 {
  "do": "shot",
  "file": "${OUT}/03_sent.png",
  "of": "ai"
 },
 {
  "do": "quit"
 }
]