[
 {
  "do": "tool",
  "name": "run_command",
  "args": {
   "commands": [
    "line",
    "0,0",
    "50,0",
    "ESC"
   ]
  },
  "out": "${OUT}/u1.txt"
 },
 {
  "do": "type",
  "text": "draw a circle here, then open other.dxf and draw a circle there too"
 },
 {
  "do": "send"
 },
 {
  "do": "wait_idle",
  "timeout": 30000
 },
 {
  "do": "wait",
  "ms": 300
 },
 {
  "do": "tool",
  "name": "list_entities",
  "args": {},
  "out": "${OUT}/e1_active_after_run.txt"
 },
 {
  "do": "dump",
  "file": "${OUT}/d1.txt",
  "in": "ai"
 },
 {
  "do": "shot",
  "file": "${OUT}/s1.png",
  "of": "ai"
 },
 {
  "do": "shot",
  "file": "${OUT}/s1_main.png",
  "of": "main"
 },
 {
  "do": "expect",
  "in": "ai",
  "regex": "other\\.dxf · 1 change",
  "label": "a bar for other.dxf"
 },
 {
  "do": "click",
  "text": "Accept",
  "in": "ai",
  "may_fail": true
 },
 {
  "do": "click",
  "text": "aiRevertButton",
  "in": "ai",
  "index": 1
 },
 {
  "do": "dump",
  "file": "${OUT}/d2.txt",
  "in": "ai"
 },
 {
  "do": "shot",
  "file": "${OUT}/s2.png",
  "of": "ai"
 },
 {
  "do": "tool",
  "name": "list_entities",
  "args": {},
  "out": "${OUT}/e2_active_after_revert.txt"
 },
 {
  "do": "expect",
  "in": "file:${OUT}/e2_active_after_revert.txt",
  "regex": "circle",
  "not": true,
  "label": "other.dxf's circle reverted"
 },
 {
  "do": "activate",
  "index": 0
 },
 {
  "do": "wait",
  "ms": 800
 },
 {
  "do": "tool",
  "name": "list_entities",
  "args": {},
  "out": "${OUT}/e3_drawing1_after_revert.txt"
 },
 {
  "do": "expect",
  "in": "file:${OUT}/e3_drawing1_after_revert.txt",
  "regex": "circle",
  "label": "drawing 1's circle still there"
 },
 {
  "do": "dump",
  "file": "${OUT}/d3.txt",
  "in": "ai"
 },
 {
  "do": "click",
  "text": "aiRevertButton",
  "in": "ai",
  "index": 0
 },
 {
  "do": "tool",
  "name": "list_entities",
  "args": {},
  "out": "${OUT}/e4_drawing1_reverted.txt"
 },
 {
  "do": "expect",
  "in": "file:${OUT}/e4_drawing1_reverted.txt",
  "regex": "circle",
  "not": true,
  "label": "drawing 1's circle reverted"
 },
 {
  "do": "dump",
  "file": "${OUT}/d4.txt",
  "in": "ai"
 },
 {
  "do": "shot",
  "file": "${OUT}/s4.png",
  "of": "ai"
 },
 {
  "do": "quit"
 }
]