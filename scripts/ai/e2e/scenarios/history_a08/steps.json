[
 {
  "do": "tool",
  "name": "run_command",
  "args": {
   "commands": [
    "circle",
    "100,100",
    "25",
    "ESC"
   ]
  }
 },
 {
  "do": "tool",
  "name": "select_entities",
  "args": {
   "all": true
  }
 },
 {
  "do": "drop",
  "files": [
   "${FIXTURES}/spec-sheet.pdf",
   "${FIXTURES}/sketch.png"
  ]
 },
 {
  "do": "type",
  "text": "@selection what are these files?"
 },
 {
  "do": "send"
 },
 {
  "do": "wait_idle",
  "timeout": 30000
 },
 {
  "do": "shot",
  "file": "${OUT}/01_first.png",
  "of": "ai"
 },
 {
  "do": "new_drawing"
 },
 {
  "do": "wait",
  "ms": 800
 },
 {
  "do": "shot",
  "file": "${OUT}/02_other_drawing.png",
  "of": "ai"
 },
 {
  "do": "activate",
  "index": 0
 },
 {
  "do": "wait",
  "ms": 800
 },
 {
  "do": "shot",
  "file": "${OUT}/03_back.png",
  "of": "ai"
 },
 {
  "do": "dump",
  "file": "${OUT}/03_dump.txt",
  "in": "ai"
 },
 {
  "do": "type",
  "text": "and what is the hole diameter in the PDF?"
 },
 {
  "do": "send"
 },
 {
  "do": "wait_idle",
  "timeout": 30000
 },
 {
  "do": "shot",
  "file": "${OUT}/04_followup.png",
  "of": "ai"
 },
 {
  "do": "dump",
  "file": "${OUT}/04_dump.txt",
  "in": "ai"
 },
 {
  "do": "quit"
 }
]