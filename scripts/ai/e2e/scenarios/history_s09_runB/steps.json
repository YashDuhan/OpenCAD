[
 {
  "do": "tool",
  "name": "open_drawing",
  "args": {
   "path": "${SCEN}/files/main.dxf"
  }
 },
 {
  "do": "wait",
  "ms": 600
 },
 {
  "do": "click",
  "text": "Chat history of this drawing",
  "in": "ai"
 },
 {
  "do": "dump",
  "file": "${OUT}/popup.txt",
  "in": "popup"
 },
 {
  "do": "keys",
  "keys": "Down",
  "target": "focus"
 },
 {
  "do": "keys",
  "keys": "Return",
  "target": "focus"
 },
 {
  "do": "wait",
  "ms": 500
 },
 {
  "do": "dump",
  "file": "${OUT}/resumed_corrupt.txt",
  "in": "ai"
 },
 {
  "do": "shot",
  "file": "${OUT}/1_resumed_corrupt.png",
  "of": "ai"
 },
 {
  "do": "type",
  "text": "Question into the damaged chat"
 },
 {
  "do": "send"
 },
 {
  "do": "wait_idle"
 },
 {
  "do": "click",
  "text": "Chat history of this drawing",
  "in": "ai"
 },
 {
  "do": "dump",
  "file": "${OUT}/popup_after.txt",
  "in": "popup"
 },
 {
  "do": "shot",
  "file": "${OUT}/2_popup_after.png",
  "of": "popup"
 },
 {
  "do": "keys",
  "keys": "Escape",
  "target": "focus"
 },
 {
  "do": "wait",
  "ms": 1200
 },
 {
  "do": "quit"
 }
]