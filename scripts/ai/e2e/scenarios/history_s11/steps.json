[
 {
  "do": "tool",
  "name": "use_menu",
  "args": {
   "path": "File > Save as..."
  }
 },
 {
  "do": "tool",
  "name": "handle_dialog",
  "args": {
   "file_path": "${SCEN}/files/n.dxf",
   "button": "Save"
  }
 },
 {
  "do": "type",
  "text": "Draw a circle please"
 },
 {
  "do": "send"
 },
 {
  "do": "wait",
  "ms": 1500
 },
 {
  "do": "shot",
  "file": "${OUT}/1_waiting.png",
  "of": "ai"
 },
 {
  "do": "click",
  "text": "New Chat",
  "in": "ai"
 },
 {
  "do": "wait_idle",
  "timeout": 10000
 },
 {
  "do": "shot",
  "file": "${OUT}/2_after_new_chat.png",
  "of": "ai"
 },
 {
  "do": "dump",
  "file": "${OUT}/after_new_chat.txt",
  "in": "ai"
 },
 {
  "do": "click",
  "text": "Chat history of this drawing",
  "in": "ai"
 },
 {
  "do": "dump",
  "file": "${OUT}/popup.txt",
  "in": "popup"
 },
 {
  "do": "shot",
  "file": "${OUT}/3_popup.png",
  "of": "popup"
 },
 {
  "do": "keys",
  "keys": "Return",
  "target": "focus"
 },
 {
  "do": "wait",
  "ms": 500
 },
 {
  "do": "dump",
  "file": "${OUT}/resumed.txt",
  "in": "ai"
 },
 {
  "do": "shot",
  "file": "${OUT}/4_resumed.png",
  "of": "ai"
 },
 {
  "do": "type",
  "text": "Did you draw it?"
 },
 {
  "do": "send"
 },
 {
  "do": "wait_idle",
  "timeout": 30000
 },
 {
  "do": "dump",
  "file": "${OUT}/after_followup.txt",
  "in": "ai"
 },
 {
  "do": "shot",
  "file": "${OUT}/5_after_followup.png",
  "of": "ai"
 },
 {
  "do": "wait",
  "ms": 1200
 },
 {
  "do": "quit"
 }
]