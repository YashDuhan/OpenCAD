[
 {
  "do": "type",
  "text": "Draw a circle radius 25 at 100,100"
 },
 {
  "do": "send"
 },
 {
  "do": "wait_idle"
 },
 {
  "do": "click",
  "text": "Check & fix",
  "in": "ai"
 },
 {
  "do": "wait_idle",
  "timeout": 30000
 },
 {
  "do": "dump",
  "file": "${OUT}/live.txt",
  "in": "ai"
 },
 {
  "do": "shot",
  "file": "${OUT}/1_live_after_check.png",
  "of": "ai"
 },
 {
  "do": "new_drawing"
 },
 {
  "do": "activate",
  "index": 0
 },
 {
  "do": "dump",
  "file": "${OUT}/reloaded.txt",
  "in": "ai"
 },
 {
  "do": "shot",
  "file": "${OUT}/2_reloaded.png",
  "of": "ai"
 },
 {
  "do": "click",
  "text": "Chat history of this drawing",
  "in": "ai"
 },
 {
  "do": "dump",
  "file": "${OUT}/popup.txt",
  "in": "popup"
 },
 {
  "do": "keys",
  "text": "digest",
  "target": "focus"
 },
 {
  "do": "dump",
  "file": "${OUT}/popup_search.txt",
  "in": "popup"
 },
 {
  "do": "keys",
  "keys": "Escape",
  "target": "focus"
 },
 {
  "do": "wait",
  "ms": 1200
 },
 {
  "do": "quit"
 }
]