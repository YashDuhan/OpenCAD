[
 {
  "do": "type",
  "text": "Draw a circle"
 },
 {
  "do": "send"
 },
 {
  "do": "wait_idle",
  "timeout": 20000
 },
 {
  "do": "click",
  "text": "Check my work automatically",
  "in": "ai"
 },
 {
  "do": "wait",
  "ms": 300
 },
 {
  "do": "shot",
  "file": "${OUT}/01_toggled.png",
  "of": "ai"
 },
 {
  "do": "type",
  "text": "Draw another circle"
 },
 {
  "do": "send"
 },
 {
  "do": "wait_idle",
  "timeout": 20000
 },
 {
  "do": "shot",
  "file": "${OUT}/02_auto_pass.png",
  "of": "ai"
 },
 {
  "do": "dump",
  "file": "${OUT}/02_auto_pass.txt",
  "in": "ai"
 },
 {
  "do": "expect",
  "in": "ai",
  "regex": "Debugger\\nchecking automatically",
  "label": "automatic pass ran"
 },
 {
  "do": "type",
  "text": "What is a circle?"
 },
 {
  "do": "send"
 },
 {
  "do": "wait_idle",
  "timeout": 20000
 },
 {
  "do": "expect",
  "in": "ai",
  "regex": "(Debugger[\\s\\S]*){2}",
  "not": true,
  "label": "no pass after an answer without tools"
 },
 {
  "do": "type",
  "text": "What is in the drawing?"
 },
 {
  "do": "send"
 },
 {
  "do": "wait_idle",
  "timeout": 20000
 },
 {
  "do": "shot",
  "file": "${OUT}/03_read_only_run.png",
  "of": "ai"
 },
 {
  "do": "dump",
  "file": "${OUT}/03_read_only_run.txt",
  "in": "ai"
 },
 {
  "do": "quit"
 }
]