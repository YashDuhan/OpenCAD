[
 {
  "do": "tool",
  "name": "run_command",
  "args": {
   "commands": [
    "circle",
    "0,0",
    "5"
   ]
  }
 },
 {
  "do": "setting",
  "key": "checkWorkAutomatically",
  "value": true
 },
 {
  "do": "click",
  "text": "Plan",
  "in": "ai"
 },
 {
  "do": "type",
  "text": "Clean up the drawing"
 },
 {
  "do": "send"
 },
 {
  "do": "wait",
  "ms": 2000
 },
 {
  "do": "click",
  "text": "Reject",
  "in": "ai"
 },
 {
  "do": "wait_idle",
  "timeout": 20000
 },
 {
  "do": "shot",
  "file": "${OUT}/01_after_reject.png",
  "of": "ai"
 },
 {
  "do": "dump",
  "file": "${OUT}/01_after_reject.txt",
  "in": "ai"
 },
 {
  "do": "tool",
  "name": "list_entities",
  "args": {},
  "out": "${OUT}/entities.txt"
 },
 {
  "do": "expect",
  "in": "ai",
  "regex": "Debugger",
  "not": true,
  "label": "no automatic pass after the user rejected the plan"
 },
 {
  "do": "expect",
  "in": "file:${OUT}/entities.txt",
  "regex": "line",
  "not": true,
  "label": "nothing drawn after a rejection"
 },
 {
  "do": "quit"
 }
]