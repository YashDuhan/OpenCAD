 {
  "do": "type",
  "text": "tidy the layers then start over"
 },
 {
  "do": "send"
 },
 {
  "do": "wait",
  "ms": 8000
 },
 {
  "do": "expect",
  "in": "ai",
  "regex": "Safety rule: deletes",
  "label": "deleting most of the drawing asks, even in Full access"
 },
 {
  "do": "shot",
  "file": "${OUT}/1_guard.png",
  "of": "ai"
 },
 {
  "do": "click",
  "text": "Deny",
  "in": "ai"
 },
 {
  "do": "wait_idle",
  "timeout": 30000
 },
 {
  "do": "tool",
  "name": "layers",
  "args": {},
  "out": "${OUT}/layers.txt"
 },
 {
  "do": "expect",
  "in": "file:${OUT}/layers.txt",
  "regex": "\"Body Outline\": 1 entities",
  "label": "cnlayer kept the case; switch, move and rename worked"
 },
 {
  "do": "expect",
  "in": "file:${OUT}/layers.txt",
  "regex": "\"SCREEN\": 0 entities; colour #00ffff, width 0.25 mm[^\\n]*hidden",
  "label": "create with look, set hidden"
 },
 {
  "do": "expect",
  "in": "file:${OUT}/layers.txt",
  "regex": "(?-i)\"(outline|screen)\"",
  "not": true,
  "label": "no lowercase duplicate layers"
 },
 {
  "do": "expect",
  "in": "file:${OUT}/requests.jsonl",
  "regex": "A layer \\\\\"SCREEN\\\\\" exists already",
  "label": "a case-only duplicate is refused"
 },
 {
  "do": "expect",
  "in": "file:${OUT}/requests.jsonl",
  "regex": "Layer \\\\\"Body Outline\\\\\" has 1 entities",
  "label": "removing a layer with entities needs a choice"
 },
 {
  "do": "tool",
  "name": "list_entities",
  "args": {
   "type": "mtext"
  },
  "out": "${OUT}/mtext.txt"
 },
 {
  "do": "expect",
  "in": "file:${OUT}/mtext.txt",
  "regex": "1 matching",
  "label": "a literal \\\\n became a multi-line text"
 },
 {
  "do": "expect",
  "in": "file:${OUT}/requests.jsonl",
  "regex": "Zoomed to the area \\(0, -20\\) \\.\\. \\(60, 40\\)\\.\\\\nVisible area: x 0 \\.\\. 60,",
  "label": "zoom reports the new view"
 },
 {
  "do": "tool",
  "name": "get_drawing_info",
  "args": {},
  "out": "${OUT}/info.txt"
 },
 {
  "do": "expect",
  "in": "file:${OUT}/info.txt",
  "regex": "Entities: 32",
  "label": "nothing deleted after Deny"
 },
 {
  "do": "quit"
 }
]